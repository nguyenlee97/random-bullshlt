# ── GreenNode MaaS (LLM) ─────────────────────────────────────────────────────
# Provided by GreenNode AgentBase — auto-injected at runtime as GREENNODE_CLIENT_ID / GREENNODE_CLIENT_SECRET
# Set manually for local development only
AI_PLATFORM_API_KEY=your-greennode-maas-api-key
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=minimax/minimax-m2.5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30

# Cross-provider fallback is deliberately disabled by default. Enable only
# after approving the campaign data classification for the fallback provider.
ALLOW_OFFSHORE_LLM_FALLBACK=false
DATA_CLASSIFICATION=confidential
LLM_FALLBACK_ALLOWED_CLASSIFICATIONS=public,internal
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ── Backend API (VPS or GreenNode Custom Agent) ───────────────────────────────
BACKEND_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=camp_ads
DEMO_NAMESPACE=local-demo


# ── Agent server ──────────────────────────────────────────────────────────────
# GreenNode AgentBase Runtime Contract: container MUST listen on 8080
AGENT_PORT=8080
AGENT_HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://agent.pawgrammers.io.vn,http://localhost:5175,http://localhost:5173
CORS_ALLOW_TUNNELS=false

# Optional production-grade features. Keep experimental retrieval off until
# its golden-set release gate passes.
USE_LANGGRAPH_FREEFORM=true
USE_CAMPAIGN_AUTOPILOT=false
AUTOPILOT_WORKER_POLL_SECONDS=0.5
AUTOPILOT_TASK_LEASE_SECONDS=90
AUTOPILOT_TASK_MAX_ATTEMPTS=3
AUTOPILOT_MAX_GENERATED_ASSETS=3
AUTOPILOT_CREATIVE_GENERATION_CONCURRENCY=2
USE_RAG_AUDIENCE=false
RAG_QUERY_REWRITE=false
RAG_USE_RERANK=false
RAG_USE_CRITIC_SELECTOR=false
RAG_TOP_RETRIEVE=50
RAG_TOP_FINAL=25
QDRANT_URL=http://localhost:6333
RERANK_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1/rerank
RERANK_MODEL=qwen/qwen3-reranker-8b
USE_VLM_CREATIVE=false
VLM_MODEL=
VLM_CONFIDENCE_THRESHOLD=0.8
CREATIVE_ANALYSIS_TIMEOUT_SECONDS=15
CREATIVE_WORKER_POLL_SECONDS=0.5
CREATIVE_WORKER_CONCURRENCY=6
CREATIVE_JOB_STALE_SECONDS=90
RATE_LIMIT_ENABLED=true
AGENT_API_KEY=
# Anonymous device identity cookie. Keep false for plain HTTP localhost and set
# true on every HTTPS deployment.
ANONYMOUS_COOKIE_SECURE=false
ANONYMOUS_COOKIE_MAX_AGE_DAYS=90
ACCOUNT_COOKIE_SECURE=false
ACCOUNT_SESSION_MAX_AGE_DAYS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_ACCOUNT_LIMIT=3
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_ACCOUNT_LIMIT=10

# Zalo Login (Social OAuth v4). Keep disabled until the exact HTTPS callback is
# registered in the Zalo app. Secrets belong only in agent/.env / VPS service env.
ZALO_LOGIN_ENABLED=false
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_LOGIN_REDIRECT_URI=https://agent.pawgrammers.io.vn/agent/api/agent/auth/zalo/callback
ZALO_LOGIN_PERMISSION_URL=https://oauth.zaloapp.com/v4/permission
ZALO_LOGIN_TOKEN_URL=https://oauth.zaloapp.com/v4/access_token
ZALO_PROFILE_URL=https://graph.zalo.me/v2.0/me
ZALO_OAUTH_ATTEMPT_TTL_SECONDS=600

# Zalo OA webhook/linking. This is a separate switch because an OA exposes only
# one live webhook; enabling code does not move the OA console configuration.
ZALO_OA_ENABLED=false
ZALO_OA_ID=
ZALO_OA_NAME=IOT Generation
ZALO_OA_SECRET=
# Initial OA API credentials. Keep these only in deployment secrets. The
# service persists each rotated pair to the root-readable store below.
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_TOKEN_STORE_PATH=/var/lib/advertising-agent/zalo-oa-token.json
ZALO_OA_TOKEN_URL=https://oauth.zaloapp.com/v4/oa/access_token
ZALO_OA_API_BASE_URL=https://openapi.zalo.me/v3.0/oa
ZALO_OA_RECOVERY_MAX_USERS=500
ZALO_OA_RECOVERY_CONCURRENCY=6
ZALO_AGENT_WORKER_ENABLED=false
ZALO_OUTBOUND_ENABLED=false
# Official OpenAI Responses API for the Zalo conversational planner. Keep the
# key server-side; prompts and responses use store=false.
OPENAI_API_KEY=
ZALO_OPENAI_ENABLED=false
ZALO_CHAT_MODEL=gpt-5.4-mini
ZALO_CHAT_REASONING_EFFORT=low
ZALO_CHAT_MAX_OUTPUT_TOKENS=1200
ZALO_CHAT_TIMEOUT_SECONDS=45
ZALO_CHAT_MAX_RETRIES=1
ZALO_WORKER_POLL_SECONDS=1.0
ZALO_WORKER_LEASE_SECONDS=180
ZALO_WORKER_MAX_ATTEMPTS=5
ZALO_WEB_WORKSPACE_URL=https://agent.pawgrammers.io.vn
ZALO_PUBLIC_API_URL=https://agent.pawgrammers.io.vn/agent/api/agent
ZALO_MEDIA_TTL_SECONDS=900
ZALO_WEBHOOK_MAX_SKEW_SECONDS=600
ZALO_CHANNEL_LINK_TTL_SECONDS=600

# ── Auto-injected by GreenNode AgentBase Runtime (DO NOT set manually) ────────
# GREENNODE_CLIENT_ID=<auto>
# GREENNODE_CLIENT_SECRET=<auto>
# GREENNODE_AGENT_IDENTITY=<auto>
# GREENNODE_ENDPOINT_URL=<auto>
