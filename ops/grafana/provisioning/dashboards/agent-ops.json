{
  "title": "Agent Ops",
  "uid": "agent-ops",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate by handler",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (handler) (rate(http_requests_total[5m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (s) — SLO: chat < 8s",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "LLM call rate by outcome",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum by (outcome) (rate(agent_llm_calls_total[5m])) or on() vector(0)", "legendFormat": "{{outcome}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Fallback level fires — SLO: L3 < 2%",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum by (level) (increase(agent_fallback_level_total[1h])) or on() vector(0)", "legendFormat": "{{level}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Token burn (per direction)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum by (direction) (rate(agent_llm_tokens_total[5m])) or on() vector(0)", "legendFormat": "{{direction}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Tool calls by outcome",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (tool, outcome) (rate(agent_tool_calls_total[5m])) or on() vector(0)", "legendFormat": "{{tool}} {{outcome}}" }]
    },
    {
      "id": 7, "type": "stat", "title": "Orders created vs rejected (24h)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(agent_orders_created_total[24h]) or on() vector(0)", "legendFormat": "created" },
        { "expr": "sum(increase(agent_orders_rejected_total[24h])) or on() vector(0)", "legendFormat": "rejected" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Audience RAG stage latency",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(agent_rag_stage_seconds_bucket[5m])))", "legendFormat": "{{stage}} p95" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "RAG and reranker outcomes",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (outcome) (increase(agent_rag_requests_total[1h]))", "legendFormat": "rag {{outcome}}" },
        { "expr": "sum by (outcome) (increase(agent_rag_rerank_total[1h]))", "legendFormat": "rerank {{outcome}}" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Creative VLM latency and outcomes",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, model) (rate(agent_vlm_call_seconds_bucket[5m])))", "legendFormat": "{{model}} p95" },
        { "expr": "sum by (outcome) (increase(agent_vlm_calls_total[1h]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Model provider routing",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (provider, outcome) (increase(agent_llm_provider_events_total[1h])) or on() vector(0)", "legendFormat": "{{provider}} {{outcome}}" }]
    },
    {
      "id": 12, "type": "stat", "title": "HTTP 5xx ratio (15m) — SLO < 0.5%",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "expr": "(sum(rate(http_requests_total{status=~\"5..\"}[15m])) or vector(0)) / clamp_min((sum(rate(http_requests_total[15m])) or vector(0)), 0.001)" }]
    },
    {
      "id": 13, "type": "stat", "title": "Agent scrape health",
      "gridPos": { "x": 12, "y": 40, "w": 6, "h": 6 },
      "targets": [{ "expr": "max(up{job=~\"agent|advertising-agent.*\"}) or vector(0)", "legendFormat": "up" }]
    },
    {
      "id": 14, "type": "stat", "title": "Agent process uptime",
      "gridPos": { "x": 18, "y": 40, "w": 6, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "targets": [{ "expr": "(time() - max(process_start_time_seconds{job=~\"agent|advertising-agent.*\"})) or vector(0)", "legendFormat": "uptime" }]
    }
  ]
}
