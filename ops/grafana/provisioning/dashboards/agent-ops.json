{
  "title": "Agent Ops",
  "uid": "agent-ops",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate by handler",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (handler) (rate(http_requests_total[5m]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (s) — SLO: chat < 8s",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "LLM calls by outcome (empty = trouble)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum by (outcome) (rate(agent_llm_calls_total[5m]))" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Fallback level fires — SLO: L3 < 2%",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum by (level) (increase(agent_fallback_level_total[1h]))" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Token burn (per direction)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "sum by (direction) (rate(agent_llm_tokens_total[5m]))" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Tool calls by outcome",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (tool, outcome) (rate(agent_tool_calls_total[5m]))" }]
    },
    {
      "id": 7, "type": "stat", "title": "Orders created vs rejected (24h)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(agent_orders_created_total[24h])", "legendFormat": "created" },
        { "expr": "sum(increase(agent_orders_rejected_total[24h]))", "legendFormat": "rejected" }
      ]
    }
  ]
}
